// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS ───────────────────────────────────────────────────────────────────

model User {
  id                String   @id @default(uuid())
  email             String?  @unique
  phone             String   @unique
  passwordHash      String   @map("password_hash")
  fullName          String?  @map("full_name")
  avatarUrl         String?  @map("avatar_url")
  role              UserRole @default(CUSTOMER)
  userType          UserType @default(LOCAL) @map("user_type")
  preferredCurrency Currency @default(NGN) @map("preferred_currency")
  whatsappOptedIn   Boolean  @default(true) @map("whatsapp_opted_in")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  addresses        DeliveryAddress[]
  orders           Order[]
  whatsappMessages WhatsappMessage[]
  reviews          Review[]
  notifications    Notification[]
  groupBuyEventsCreated GroupBuyEvent[]    @relation("GroupBuyCreator")
  groupBuySlots         GroupBuySlot[]     @relation("GroupBuyCustomer")
  groupBuyWaitlist      GroupBuyWaitlist[] @relation("GroupBuyWaitlistCustomer")
  disputes         Dispute[]
  cleaningRequests CleaningRequest[]
  partnerApplications PartnerApplication[] @relation("UserPartnerApplications")
  supportMessages     SupportMessage[]     @relation("UserSupportMessages")

  @@map("users")
}

enum UserRole {
  CUSTOMER
  ADMIN
  OPS_MANAGER
  HUB_STAFF
  SUPPORT
  VENDOR
  ARTISAN

  @@map("user_role")
}

enum UserType {
  LOCAL
  DIASPORA

  @@map("user_type")
}

enum Currency {
  NGN
  GBP
  USD
  EUR

  @@map("currency")
}

// ─── MARKETS ─────────────────────────────────────────────────────────────────

model Market {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  category  String
  imageUrl  String?  @map("image_url")
  isActive  Boolean  @default(false) @map("is_active")
  phase     Int      @default(1)
  lat       Decimal? @db.Decimal(10, 8)
  lng       Decimal? @db.Decimal(11, 8)
  createdAt DateTime @default(now()) @map("created_at")

  vendors       Vendor[]
  runDays       RunDay[]
  agents        MarketAgent[]
  deliveryRates MarketDeliveryRate[]

  @@map("markets")
}

model RunDay {
  id                    String  @id @default(uuid())
  marketId              String  @map("market_id")
  dayOfWeek             Int     @map("day_of_week") // 0=Sun 6=Sat
  cutoffHour            Int     @default(20) @map("cutoff_hour")
  cutoffMinute          Int     @default(0)  @map("cutoff_minute")
  isMasterConsolidation Boolean @default(false) @map("is_master_consolidation")

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@map("run_days")
}

// ─── DELIVERY ─────────────────────────────────────────────────────────────────

model DeliveryZone {
  id                         String   @id @default(uuid())
  name                       String
  cities                     String[] // city names that auto-match this zone (lowercase)
  isActive                   Boolean  @default(true) @map("is_active")
  deliveryFeeNgn             Decimal  @map("delivery_fee_ngn") @db.Decimal(10, 2)
  consolidatedDeliveryFeeNgn Decimal  @map("consolidated_delivery_fee_ngn") @db.Decimal(10, 2)

  addresses     DeliveryAddress[]
  orders        Order[]
  deliveryRates MarketDeliveryRate[]

  @@map("delivery_zones")
}

model MarketDeliveryRate {
  id             String   @id @default(uuid())
  marketId       String   @map("market_id")
  deliveryZoneId String   @map("delivery_zone_id")
  priceNgn       Decimal  @db.Decimal(12, 2) @map("price_ngn")
  updatedAt      DateTime @updatedAt @map("updated_at")

  market       Market       @relation(fields: [marketId], references: [id], onDelete: Cascade)
  deliveryZone DeliveryZone @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)

  @@unique([marketId, deliveryZoneId])
  @@map("market_delivery_rates")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model DeliveryAddress {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  label               String? // "Home", "Office", "Mum's place"
  landmarkDescription String?  @map("landmark_description")
  googlePlaceId       String?  @map("google_place_id")
  lat                 Decimal? @db.Decimal(10, 8)
  lng                 Decimal? @db.Decimal(11, 8)
  deliveryZoneId      String?  @map("delivery_zone_id")
  isDefault           Boolean  @default(false) @map("is_default")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  orders       Order[]

  @@index([userId, isDefault])
  @@map("delivery_addresses")
}

// ─── VENDORS ──────────────────────────────────────────────────────────────────

model Vendor {
  id                   String             @id @default(uuid())
  userId               String?            @map("user_id")
  marketId             String             @map("market_id")
  businessName         String             @map("business_name")
  contactName          String?            @map("contact_name")
  phone                String?
  stallReference       String?            @map("stall_reference")
  verificationStatus   VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt           DateTime?          @map("verified_at")
  verifiedBy           String?            @map("verified_by")
  bankAccountNumber    String?            @map("bank_account_number")
  bankCode             String?            @map("bank_code")
  ratingAverage        Decimal?           @map("rating_average") @db.Decimal(3, 2)
  totalOrdersFulfilled Int                @default(0) @map("total_orders_fulfilled")
  createdByAdmin       Boolean            @default(false) @map("created_by_admin")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  market       Market       @relation(fields: [marketId], references: [id], onDelete: Cascade)
  products     Product[]
  priceEntries PriceEntry[]
  orderItems   OrderItem[]
  reviews      Review[]
  payouts      Payout[]

  @@index([marketId, verificationStatus])
  @@map("vendors")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  SUSPENDED

  @@map("verification_status")
}

// ─── CATEGORIES ───────────────────────────────────────────────────────────────

model Category {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  iconUrl  String? @map("icon_url")
  parentId String? @map("parent_id")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

// ─── PRODUCTS ─────────────────────────────────────────────────────────────────

model Product {
  id               String                 @id @default(uuid())
  vendorId         String                 @map("vendor_id")
  marketId         String                 @map("market_id")
  categoryId       String?                @map("category_id")
  name             String
  description      String?
  unit             String // "kg", "paint bucket", "bag (50kg)", "dozen"
  minOrderQuantity Decimal                @default(1) @map("min_order_quantity") @db.Decimal(10, 2)
  imageUrls        String[]               @map("image_urls")
  isSeasonal       Boolean                @default(false) @map("is_seasonal")
  isActive         Boolean                @default(true) @map("is_active")
  stockQuantity    Int?                   @map("stock_quantity")      // null = unlimited
  reservedQuantity Int                    @default(0) @map("reserved_quantity")
  approvalStatus   ProductApprovalStatus  @default(APPROVED) @map("approval_status")
  approvedAt       DateTime?              @map("approved_at")
  approvedBy       String?                @map("approved_by")
  rejectionReason  String?                @map("rejection_reason")
  createdAt        DateTime               @default(now()) @map("created_at")

  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  priceEntries PriceEntry[]
  orderItems   OrderItem[]

  @@index([marketId, vendorId, isActive])
  @@index([approvalStatus, marketId])
  @@index([approvalStatus, vendorId])
  @@map("products")
}

enum ProductApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED

  @@map("product_approval_status")
}

// ─── PRICE INTELLIGENCE ───────────────────────────────────────────────────────

model MarketAgent {
  id                       String      @id @default(uuid())
  fullName                 String      @map("full_name")
  phone                    String      @unique
  marketId                 String      @map("market_id")
  employmentStatus         AgentStatus @default(ACTIVE) @map("employment_status")
  totalVerifiedSubmissions Int         @default(0) @map("total_verified_submissions")
  accuracyScore            Decimal?    @map("accuracy_score") @db.Decimal(5, 2)
  createdAt                DateTime    @default(now()) @map("created_at")
  updatedAt                DateTime    @updatedAt @map("updated_at")

  market       Market       @relation(fields: [marketId], references: [id], onDelete: SetNull)
  priceEntries PriceEntry[]
  orderItems   OrderItem[]

  @@index([marketId, employmentStatus])
  @@map("market_agents")
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
  TERMINATED

  @@map("agent_status")
}

model PriceEntry {
  id                 String            @id @default(uuid())
  productId          String            @map("product_id")
  vendorId           String            @map("vendor_id")
  priceNgn           Decimal           @map("price_ngn") @db.Decimal(10, 2)
  recordedBy         String?           @map("recorded_by")
  recordedAt         DateTime          @default(now()) @map("recorded_at")
  verificationStatus PriceVerifyStatus @default(PENDING) @map("verification_status")
  isCurrent          Boolean           @default(false) @map("is_current")
  notes              String?

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor  Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  agent   MarketAgent? @relation(fields: [recordedBy], references: [id], onDelete: SetNull)

  @@index([productId, isCurrent])
  @@index([verificationStatus])
  @@index([vendorId, recordedAt])
  @@map("price_entries")
}

enum PriceVerifyStatus {
  PENDING
  VERIFIED
  FLAGGED

  @@map("price_verify_status")
}

// ─── ORDERS ───────────────────────────────────────────────────────────────────

model Order {
  id                    String      @id @default(uuid())
  orderNumber           String      @unique @map("order_number") // AYF-2024-00001
  userId                String      @map("user_id")
  status                OrderStatus @default(PENDING_PAYMENT)
  deliveryAddressId     String?     @map("delivery_address_id")
  deliveryZoneId        String?     @map("delivery_zone_id")
  scheduledDeliveryDate DateTime?   @map("scheduled_delivery_date") @db.Date
  isConsolidated        Boolean     @default(false) @map("is_consolidated")
  subtotalNgn           Decimal     @map("subtotal_ngn") @db.Decimal(10, 2)
  deliveryFeeNgn        Decimal     @map("delivery_fee_ngn") @db.Decimal(10, 2)
  serviceFeeNgn         Decimal     @map("service_fee_ngn") @db.Decimal(10, 2)
  discountNgn           Decimal     @default(0) @map("discount_ngn") @db.Decimal(10, 2)
  promoCode             String?     @map("promo_code")
  totalNgn              Decimal     @map("total_ngn") @db.Decimal(10, 2)
  currencyPaid          Currency    @default(NGN) @map("currency_paid")
  fxRate                Decimal?    @map("fx_rate") @db.Decimal(10, 4)
  paymentMethod         String?     @map("payment_method")
  paystackReference     String?     @unique @map("paystack_reference")
  specialInstructions   String?     @map("special_instructions")
  verificationCode      String?     @map("verification_code") // 6-digit code for delivery confirmation
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryAddress  DeliveryAddress?     @relation(fields: [deliveryAddressId], references: [id])
  deliveryZone     DeliveryZone?        @relation(fields: [deliveryZoneId], references: [id])
  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  whatsappMessages WhatsappMessage[]
  payment          Payment?
  reviews          Review[]
  disputes         Dispute[]

  @@index([userId])
  @@index([status])
  @@index([scheduledDeliveryDate])
  @@index([deliveryZoneId, scheduledDeliveryDate])
  @@map("orders")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_CONFIRMED
  SOURCING
  AT_HUB
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUND_INITIATED

  @@map("order_status")
}

model OrderItem {
  id                String         @id @default(uuid())
  orderId           String         @map("order_id")
  productId         String         @map("product_id")
  vendorId          String         @map("vendor_id")
  marketId          String         @map("market_id")
  quantity          Decimal        @db.Decimal(10, 2)
  unit              String
  priceNgnAtOrder   Decimal        @map("price_ngn_at_order") @db.Decimal(10, 2)
  subtotalNgn       Decimal        @map("subtotal_ngn") @db.Decimal(10, 2)
  sourcingStatus    SourcingStatus @default(PENDING) @map("sourcing_status")
  sourcedByAgentId  String?        @map("sourced_by_agent_id")
  substitutionNotes String?        @map("substitution_notes")

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  vendor  Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  agent   MarketAgent? @relation(fields: [sourcedByAgentId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([vendorId, sourcingStatus])
  @@map("order_items")
}

enum SourcingStatus {
  PENDING
  SOURCED
  SUBSTITUTED
  UNAVAILABLE

  @@map("sourcing_status")
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  status    String
  note      String?
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

// ─── WHATSAPP ─────────────────────────────────────────────────────────────────

model WhatsappMessage {
  id          String           @id @default(uuid())
  userId      String?          @map("user_id")
  orderId     String?          @map("order_id")
  direction   MessageDirection
  messageType String?          @map("message_type")
  messageBody String?          @map("message_body")
  twilioSid   String?          @map("twilio_sid")
  status      String?
  sentAt      DateTime         @default(now()) @map("sent_at")

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@map("whatsapp_messages")
}

enum MessageDirection {
  OUTBOUND
  INBOUND

  @@map("message_direction")
}

// ─── ARTISANS ─────────────────────────────────────────────────────────────────

model Artisan {
  id                 String             @id @default(uuid())
  userId             String?            @map("user_id")
  name               String
  category           String
  bio                String?
  portfolioImages    String[]           @map("portfolio_images")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  isAvailable        Boolean            @default(true) @map("is_available")
  ratingAverage      Decimal?           @map("rating_average") @db.Decimal(3, 2)
  phone              String?
  createdByAdmin     Boolean            @default(false) @map("created_by_admin")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  bankAccountNumber  String?            @map("bank_account_number")
  bankCode           String?            @map("bank_code")

  services ArtisanService[]
  reviews  Review[]
  payouts  Payout[]

  @@map("artisans")
}

model ArtisanService {
  id             String   @id @default(uuid())
  artisanId      String   @map("artisan_id")
  serviceName    String   @map("service_name")
  priceNgn       Decimal  @map("price_ngn") @db.Decimal(10, 2)
  description    String?
  turnaroundDays Int?     @map("turnaround_days")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  artisan Artisan @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@map("artisan_services")
}

// ─── SHORTLETS ────────────────────────────────────────────────────────────────

model Apartment {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  name         String
  location     String
  ratePerNight Decimal  @map("rate_per_night") @db.Decimal(10, 2)
  images       String[]
  isAvailable  Boolean  @default(true) @map("is_available")
  isVerified   Boolean  @default(false) @map("is_verified")
  amenities    String[]
  createdByAdmin Boolean @default(false) @map("created_by_admin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("apartments")
}

// ─── PROMOTIONS ───────────────────────────────────────────────────────────────

model Promotion {
  id            String       @id @default(uuid())
  code          String       @unique
  description   String?
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(10, 2)
  minOrderNgn   Decimal?     @map("min_order_ngn") @db.Decimal(10, 2)
  maxUsesTotal  Int?         @map("max_uses_total")
  usedCount     Int          @default(0) @map("used_count")
  validFrom     DateTime     @map("valid_from")
  validTo       DateTime     @map("valid_to")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([code, isActive])
  @@map("promotions")
}

enum DiscountType {
  FIXED
  PERCENTAGE

  @@map("discount_type")
}

// ─── PAYMENTS ─────────────────────────────────────────────────────────────────

model Payment {
  id        String        @id @default(uuid())
  orderId   String        @unique @map("order_id")
  amount    Decimal       @db.Decimal(10, 2)
  reference String        @unique
  status    PaymentStatus @default(PENDING) @map("payment_status")
  metadata  String? // JSON stringified Flutterwave response
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([reference])
  @@index([status, createdAt])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED

  @@map("payment_status")
}

// ─── REVIEWS & RATINGS ────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  vendorId  String?  @map("vendor_id")
  artisanId String?  @map("artisan_id")
  orderId   String?  @map("order_id")
  rating    Int      @db.SmallInt // 1-5
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor  Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  artisan Artisan? @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([vendorId, createdAt])
  @@index([artisanId, createdAt])
  @@index([orderId])
  @@map("reviews")
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

enum NotificationType {
  GROUP_BUY_NEW
  GROUP_BUY_ALMOST_FULL
  GROUP_BUY_FULL
  GROUP_BUY_PAYMENT_REMINDER
  GROUP_BUY_SLOT_RELEASED
  GROUP_BUY_WAITLIST_OFFER
  GROUP_BUY_CONFIRMED
  GROUP_BUY_CANCELLED
  GROUP_BUY_FULFILLED
  GROUP_BUY_RESERVATION_CONFIRMED
  ORDER_STATUS
  GENERAL
  CLEANING_SUBMITTED
  CLEANING_INSPECTION_SCHEDULED
  CLEANING_QUOTED
  CLEANING_DEPOSIT_CONFIRMED
  CLEANING_ASSIGNED
  CLEANING_IN_PROGRESS
  CLEANING_COMPLETED
  CLEANING_CANCELLED

  @@map("notification_type")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  data      String?          // JSON-stringified extra metadata (eventId, orderId, etc.)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ─── GROUP BUY ────────────────────────────────────────────────────────────────

enum GroupBuyStatus {
  OPEN
  FULL
  PAYING
  CONFIRMED
  CANCELLED
  FULFILLED

  @@map("group_buy_status")
}

enum GroupBuySlotStatus {
  RESERVED
  PAID
  RELEASED
  REFUNDED

  @@map("group_buy_slot_status")
}

enum GroupBuyWaitlistStatus {
  WAITING
  OFFERED
  EXPIRED
  CONVERTED

  @@map("group_buy_waitlist_status")
}

model GroupBuyEvent {
  id                   String         @id @default(uuid())
  title                String
  description          String?
  imageUrl             String?        @map("image_url")
  totalSlots           Int            @map("total_slots")
  slotsRemaining       Int            @map("slots_remaining")
  pricePerSlotNgn      Decimal        @map("price_per_slot_ngn") @db.Decimal(12, 2)
  maxSlotsPerCustomer  Int            @default(3) @map("max_slots_per_customer")
  paymentDeadlineHours Int            @default(24) @map("payment_deadline_hours")
  reservationDeadline  DateTime       @map("reservation_deadline")
  status               GroupBuyStatus @default(OPEN)
  createdBy            String         @map("created_by")
  deletedAt            DateTime?      @map("deleted_at") // soft delete
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  creator  User               @relation("GroupBuyCreator", fields: [createdBy], references: [id])
  slots    GroupBuySlot[]
  waitlist GroupBuyWaitlist[]

  @@index([status, deletedAt])
  @@index([reservationDeadline, status])
  @@map("group_buy_events")
}

model GroupBuySlot {
  id               String             @id @default(uuid())
  eventId          String             @map("event_id")
  customerId       String             @map("customer_id")
  slotsCount       Int                @map("slots_count")
  status           GroupBuySlotStatus @default(RESERVED)
  paymentReference String?            @unique @map("payment_reference")
  paidAt           DateTime?          @map("paid_at")
  reservedAt       DateTime           @default(now()) @map("reserved_at")
  paymentDeadline  DateTime?          @map("payment_deadline") // set when event → FULL

  event    GroupBuyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  customer User          @relation("GroupBuyCustomer", fields: [customerId], references: [id])

  @@unique([eventId, customerId]) // one reservation per customer per event
  @@index([eventId, status])
  @@index([customerId])
  @@index([status, paymentDeadline]) // for expiry job
  @@map("group_buy_slots")
}

model GroupBuyWaitlist {
  id          String                 @id @default(uuid())
  eventId     String                 @map("event_id")
  customerId  String                 @map("customer_id")
  slotsWanted Int                    @map("slots_wanted")
  status      GroupBuyWaitlistStatus @default(WAITING)
  notifiedAt  DateTime?              @map("notified_at") // when the offer was sent
  joinedAt    DateTime               @default(now()) @map("joined_at")

  event    GroupBuyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  customer User          @relation("GroupBuyWaitlistCustomer", fields: [customerId], references: [id])

  @@unique([eventId, customerId]) // one waitlist entry per customer per event
  @@index([eventId, status, joinedAt]) // FIFO ordering for waitlist progression
  @@index([customerId])
  @@index([status, notifiedAt]) // for offer-expiry job
  @@map("group_buy_waitlist")
}

// ─── PAYOUTS & DISPUTES ───────────────────────────────────────────────────────

model Payout {
  id                 String       @id @default(uuid())
  vendorId           String?      @map("vendor_id")
  artisanId          String?      @map("artisan_id")
  amount             Decimal      @db.Decimal(12, 2)
  status             PayoutStatus @default(PENDING)
  transferId         String?      @map("transfer_id")
  bankAccountNumber  String       @map("bank_account_number")
  bankCode           String       @map("bank_code")
  bankName           String?      @map("bank_name")
  reference          String       @unique
  failureReason      String?      @map("failure_reason")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  vendor             Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  artisan            Artisan?     @relation(fields: [artisanId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("payouts")
}

enum PayoutStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REJECTED

  @@map("payout_status")
}

model Dispute {
  id            String        @id @default(uuid())
  orderId       String        @map("order_id")
  userId        String        @map("user_id") // customer raising the dispute
  reason        String
  description   String
  status        DisputeStatus @default(OPEN)
  resolution    String?
  resolvedAt    DateTime?     @map("resolved_at")
  resolvedBy    String?       @map("resolved_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("disputes")
}

enum DisputeStatus {
  OPEN
  UNDER_INVESTIGATION
  RESOLVED
  REJECTED

  @@map("dispute_status")
}

// ─── CLEANING SERVICES ────────────────────────────────────────────────────────

enum CleaningCategory {
  HOME
  OFFICE
  CONSTRUCTION

  @@map("cleaning_category")
}

enum AssessmentType {
  REMOTE
  IN_PERSON

  @@map("assessment_type")
}

enum CleaningStatus {
  PENDING_QUOTE         // submitted, waiting for admin to price
  INSPECTION_SCHEDULED  // admin scheduled in-person visit (OFFICE/CONSTRUCTION)
  QUOTED                // admin sent a quote, awaiting customer acceptance
  DEPOSIT_PAID          // deposit received, pending assignment
  ASSIGNED              // cleaner assigned
  IN_PROGRESS           // cleaning underway
  COMPLETED             // done
  CANCELLED

  @@map("cleaning_status")
}

model CleaningRequest {
  id              String           @id @default(uuid())
  requestNumber   String           @unique @map("request_number") // CLN-XXXXXXXX
  userId          String           @map("user_id")

  // Service details
  category        CleaningCategory
  serviceTypes    String[]         @map("service_types")   // e.g. ["Deep cleaning", "Laundry add-on"]

  // Property details
  propertyType    String?          @map("property_type")   // "self-contained", "1-bed", "2-bed", "3-bed"
  squareFootage   Int?             @map("square_footage")  // OFFICE / CONSTRUCTION
  roomCount       Int?             @map("room_count")      // OFFICE: number of rooms/workstations
  isRecurring     Boolean          @default(false) @map("is_recurring")
  recurringFreq   String?          @map("recurring_freq")  // "daily", "weekly"

  // Location & timing
  location        String
  preferredDate   DateTime         @map("preferred_date")
  preferredTime   String?          @map("preferred_time")  // e.g. "09:00"

  // Contact person (for OFFICE / CONSTRUCTION in-person assessments)
  contactPersonName   String?      @map("contact_person_name")
  contactPersonPhone  String?      @map("contact_person_phone")
  contactPersonEmail  String?      @map("contact_person_email")
  contactPersonRole   String?      @map("contact_person_role")   // e.g. "Facility Manager"

  // Office-specific details
  floorCount          Int?         @map("floor_count")
  officeLayout        String?      @map("office_layout")         // "open-plan", "cubicles", etc.
  specialZones        String[]     @map("special_zones")          // ["server room", "boardroom"]
  cleanersNeeded      Int?         @map("cleaners_needed")
  janitorsNeeded      Int?         @map("janitors_needed")

  // Construction-specific details
  constructionType    String?      @map("construction_type")     // "residential", "commercial", "industrial"
  constructionStage   String?      @map("construction_stage")    // "post-foundation", "finishing", "handover"
  siteAccessHours     String?      @map("site_access_hours")     // "08:00-17:00"
  heavyEquipmentOnSite Boolean     @default(false) @map("heavy_equipment_on_site")
  plotSize            String?      @map("plot_size")             // "500 sqm", "2 acres"

  // Assessment type
  assessmentType      AssessmentType @default(REMOTE) @map("assessment_type")

  // Inspection workflow (OFFICE medium/large and CONSTRUCTION)
  inspectionScheduledAt  DateTime? @map("inspection_scheduled_at")
  inspectionNote         String?   @map("inspection_note")
  crewSizeRecommended    Int?      @map("crew_size_recommended")
  inspectionCompletedAt  DateTime? @map("inspection_completed_at")

  // Before/after photos + handover
  beforePhotoUrls     String[]     @map("before_photo_urls")
  afterPhotoUrls      String[]     @map("after_photo_urls")
  handoverNote        String?      @map("handover_note")

  // Media & notes
  photoUrls       String[]         @map("photo_urls")
  specialRequest  String?          @map("special_request")

  // Admin quote (filled after review)
  quoteAmountNgn  Decimal?         @map("quote_amount_ngn") @db.Decimal(12, 2)
  depositAmountNgn Decimal?        @map("deposit_amount_ngn") @db.Decimal(12, 2)
  quoteNotes      String?          @map("quote_notes")
  quotedAt        DateTime?        @map("quoted_at")
  quotedBy        String?          @map("quoted_by")       // admin userId

  // Assignment
  assignedCleanerName  String?     @map("assigned_cleaner_name")
  assignedCleanerPhone String?     @map("assigned_cleaner_phone")
  assignedAt      DateTime?        @map("assigned_at")

  // Payment
  paymentReference String?         @map("payment_reference") // CLN-XXXX-<attempt> prefix (not unique; new ref per attempt)
  depositAttempts  Int             @default(0) @map("deposit_attempts")
  depositPaidAt   DateTime?        @map("deposit_paid_at")

  // Lifecycle
  status          CleaningStatus   @default(PENDING_QUOTE)
  completedAt     DateTime?        @map("completed_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status])
  @@index([category, status])
  @@index([createdAt])
  @@index([status, inspectionScheduledAt])
  @@map("cleaning_requests")
}

// ─── PARTNER APPLICATIONS ─────────────────────────────────────────────────────

model PartnerApplication {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  partnerType String   @map("partner_type") // "LOGISTICS" | "CORPORATE" | "COMMUNITY"
  fullName    String   @map("full_name")
  email       String
  phone       String
  company     String?
  message     String?
  status      String   @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User? @relation("UserPartnerApplications", fields: [userId], references: [id], onDelete: Cascade)

  @@map("partner_applications")
}

// ─── SUPPORT MESSAGES ─────────────────────────────────────────────────────────

model SupportMessage {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  fullName  String   @map("full_name")
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("OPEN") // "OPEN" | "RESOLVED"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User? @relation("UserSupportMessages", fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_messages")
}
